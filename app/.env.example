# ── Site ─────────────────────────────────────────────────────────────
# Public URL, no trailing slash (metadata, sitemap, emails, share images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────
# MongoDB Atlas connection string (cluster in an EU region). Local dev: `npm run db`
MONGODB_URI=mongodb://127.0.0.1:27018/margokit?replicaSet=rs0

# ── Authentication (Better Auth) ─────────────────────────────────────
# Random secret, 32+ characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Same as NEXT_PUBLIC_SITE_URL in most cases
BETTER_AUTH_URL=http://localhost:3000
# Google sign-in (optional). Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Encryption ───────────────────────────────────────────────────
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts share links and license keys.
# Never change it once in production (existing links/keys would stop working).
APP_ENCRYPTION_KEY=

# ── Emails (Resend) ──────────────────────────────────────────────────
# Without a key, emails are printed in the server console (local dev)
RESEND_API_KEY=
EMAIL_FROM=Margokit <hello@margokit.com>

# ── Payment provider for Pro subscriptions (gumroad today; see README to add another) ──
BILLING_PROVIDER=gumroad

# ── Gumroad (Margokit Pro) ───────────────────────────────────────────
# Product IDs: Gumroad → product → Edit → "Product ID" (needed by the license API)
GUMROAD_PRODUCT_ID_MONTHLY=
GUMROAD_PRODUCT_ID_LIFETIME=
# Long random string. Gumroad → Settings → Advanced → Ping endpoint:
#   https://<your-domain>/api/webhooks/gumroad/<GUMROAD_PING_SECRET>
GUMROAD_PING_SECRET=

# ── E-invoicing transmission (approved platform / Peppol access point) ──
# none (default) | sandbox (local simulation, ignored in production) | <partner id once implemented>
EINVOICE_PROVIDER=none
# Status webhook: https://<your-domain>/api/einvoicing/<EINVOICE_PROVIDER>/<EINVOICE_WEBHOOK_SECRET>
EINVOICE_WEBHOOK_SECRET=

# ── Cron ─────────────────────────────────────────────────────────────
# Long random string. Vercel sends it automatically as "Authorization: Bearer …" to /api/cron/daily
CRON_SECRET=

# ── Purchase & contact links (empty = button hidden) ─────────────────
GUMROAD_URL_MONTHLY=
GUMROAD_URL_LIFETIME=
GUMROAD_PACK_URL=
GUMROAD_TRACKER_URL=
# e.g. https://wa.me/2126XXXXXXXX?text=...
WHATSAPP_URL=

# ── Legal pages (Terms / Privacy) — the repository is public, keep these out of the code ──
LEGAL_ENTITY=
LEGAL_ADDRESS=
CONTACT_EMAIL=

# ── Newsletter capture (see email-capture/Code.gs) ───────────────────
SUBSCRIBE_WEBHOOK_URL=
SUBSCRIBE_WEBHOOK_SECRET=
