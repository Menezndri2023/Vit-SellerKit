# URL publique du site, sans slash final (métadonnées, sitemap, hreflang, image de partage)
NEXT_PUBLIC_SITE_URL=https://margokit.com

# Liens Gumroad des boutons d'achat (laisser vide pour masquer le bloc)
GUMROAD_PACK_URL=https://margokit.gumroad.com/l/seller-pack
GUMROAD_TRACKER_URL=https://margokit.gumroad.com/l/tracker

# Récolte des e-mails : URL de l'application Web Apps Script (email-capture/Code.gs) et son secret.
# Sans URL, le formulaire répond « OK » mais n'enregistre rien (pratique en local).
SUBSCRIBE_WEBHOOK_URL=
SUBSCRIBE_WEBHOOK_SECRET=
